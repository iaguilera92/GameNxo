# Copia a /etc/nxogames.env en la EC2 (systemd la lee con EnvironmentFile). Sin comillas.
PORT=3001
HOST=0.0.0.0
# orígenes del juego, separados por coma (la app Capacitor de Android usa https://localhost)
CORS_ORIGIN=https://localhost,capacitor://localhost
# 1 si hay nginx / ALB delante (toma la IP real de X-Forwarded-For)
TRUST_PROXY=1
# reglas del partido (iguales a las del modo BOT)
GAMES_TO_WIN=2
GOLDEN_POINT=0
# tiempos (ms)
SEARCH_TIMEOUT_MS=5000
READY_TIMEOUT_MS=12000
MAX_MATCH_MS=1800000
DRAIN_TIMEOUT_MS=120000
# tamaño máximo de un mensaje del cliente (bytes)
MAX_PAYLOAD_BYTES=8192
# despliegue continuo (webhook de GitHub): genera el secreto con  openssl rand -hex 32
# Vacío = webhook desactivado. Debe ser el MISMO valor que el "Secret" del webhook en GitHub.
WEBHOOK_SECRET=
DEPLOY_BRANCH=main
# nombre de la app en pm2 (lo usa deploy/deploy.sh)
PM2_APP=game-backend

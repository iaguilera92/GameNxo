{
  "name": "nxogames-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Servidor de NxoGames: Socket.IO (multijugador LAN 1v1) y base para la API REST.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "socket.io-client": "4.8.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}

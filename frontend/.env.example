# Copiar a frontend/.env (no se sube a Git). Anuncios AdMob: solo en la app nativa; la web no muestra anuncios.
# VITE_ADMOB_ANDROID_APP_ID lo lee también android/app/build.gradle (manifest). Sin valor usa el ID de prueba de Google.
# IDs de prueba de Google: app ca-app-pub-3940256099942544~3347511713,
#   interstitial ca-app-pub-3940256099942544/1033173712, recompensado ca-app-pub-3940256099942544/5224354917
VITE_ADS_ENABLED=false
# true = anuncios de prueba (no pagan). Poner false solo con los IDs reales.
VITE_ADS_TEST_MODE=true
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_IOS_INTERSTITIAL_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_ADMOB_IOS_REWARDED_ID=
# IDs de TUS teléfonos de prueba, separados por coma (salen en logcat: "Use RequestConfiguration...setTestDeviceIds").
# Con ellos ves anuncios de prueba incluso en el build de producción (npm run cap:release usa .env.release).
VITE_ADMOB_TEST_DEVICES=
# EEA = simula que el teléfono de prueba está en Europa para ver el aviso de consentimiento (solo pruebas; vaciar luego)
VITE_ADMOB_CONSENT_DEBUG=

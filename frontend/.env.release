# Build de PRODUCCIÓN para Google Play: npm run cap:release (vite build --mode release).
# Vite carga primero frontend/.env (IDs de AdMob) y encima este archivo: anuncios REALES, sin modo de prueba.
# No pruebes este build tocando anuncios en tu propio teléfono (AdMob lo considera tráfico inválido): para probar,
# pon el ID de tu teléfono en VITE_ADMOB_TEST_DEVICES (frontend/.env) y verás anuncios de prueba también aquí.
VITE_ADS_ENABLED=true
VITE_ADS_TEST_MODE=false

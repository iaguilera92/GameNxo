{
  "name": "gamenxo-tennis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "build:release": "tsc --noEmit && vite build --mode release",
    "cap:release": "npm run build:release && npx cap sync android",
    "apk": "npm run cap:sync && node tools/apk.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "6.2.0",
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@fontsource/lilita-one": "5.1.0",
    "phaser": "3.90.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
